#!/usr/bin/env bash
# Construiește exclusiv pachetul Linux demo Qt IFW (.run).
# Nu utilizează și nu modifică structura instalatorului de producție.

set -Eeuo pipefail
IFS=$'\n\t'

QT_VERSION="${QT_VERSION:-6.9.3}"
QT_BASE="${QT_BASE:-$HOME/Qt}"
QT_BIN_DIR="${QT_BIN_DIR:-$QT_BASE/${QT_VERSION}/gcc_64/bin}"
QT_LIB_DIR="${QT_LIB_DIR:-$QT_BASE/${QT_VERSION}/gcc_64/lib}"
QT_PLUGINS_DIR="${QT_PLUGINS_DIR:-$QT_BASE/${QT_VERSION}/gcc_64/plugins}"
QT_QIF_DIR="${QT_QIF_DIR:-$QT_BASE/Tools/QtInstallerFramework/4.10/bin}"

ROOT="$(readlink -f "$(dirname "$0")/..")"
RELEASE_DIR="${RELEASE_DIR:-build/Desktop_Qt_${QT_VERSION//./_}-Release}"
DEMO_MAIN_DB="${DEMO_MAIN_DB:-$ROOT/demo/usg_demo.sqlite3}"
DEMO_IMAGE_DB="${DEMO_IMAGE_DB:-$ROOT/demo/usg_demo_images.sqlite3}"

CQTDEPLOYER="${CQTDEPLOYER:-cqtdeployer}"
BINARYCREATOR="${BINARYCREATOR:-$QT_QIF_DIR/binarycreator}"
QMAKE="${QMAKE:-$QT_BIN_DIR/qmake}"

WORK_ROOT="$ROOT/build/demo-package"
PREBUILD_DIR="$WORK_ROOT/prebuild"
RUNTIME_DIR="$WORK_ROOT/runtime"
INSTALLER_DIR="$WORK_ROOT/installer"
KEEP_BUILD="${KEEP_BUILD:-0}"
VERIFY_ONLY="${VERIFY_ONLY:-0}"

log()  { printf '\033[1;34m[INFO]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[WARN]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[ERR ]\033[0m %s\n' "$*" >&2; exit 1; }

require_cmd() {
    local command_name
    for command_name in "$@"; do
        command -v "$command_name" >/dev/null 2>&1 || die "Lipsește unealta: $command_name"
    done
}

cleanup() {
    if [[ "$KEEP_BUILD" != "1" ]]; then
        rm -rf -- "$WORK_ROOT"
    else
        warn "KEEP_BUILD=1: directoarele temporare demo sunt păstrate în $WORK_ROOT."
    fi
}

trap 'die "Execuția build_demo a eșuat la linia $LINENO."' ERR
trap cleanup EXIT

cd "$ROOT"
require_cmd sqlite3 python3

[[ -f "$ROOT/version.txt" ]] || die "Lipsește version.txt."
VERSION="$(tr -d '\r\n' < "$ROOT/version.txt")"
[[ "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "Versiune invalidă în version.txt: $VERSION"

FILENAME_RUN="USG_v${VERSION}_Linux_amd64_demo.run"
FILENAME_SHA256="USG_v${VERSION}_Linux_amd64_demo_run.sha256"

[[ -d "$ROOT/$RELEASE_DIR" ]] || die "Lipsește build-ul Release: $ROOT/$RELEASE_DIR"
[[ -x "$ROOT/$RELEASE_DIR/USG" ]] || die "Executabilul Release USG lipsește."
[[ -f "$DEMO_MAIN_DB" ]] || die "Baza principală demo lipsește: $DEMO_MAIN_DB"
[[ -f "$ROOT/resources/sql/sqlite/tables/image_reports.sql" ]] \
    || die "Scriptul schemei imagesReports lipsește."

if [[ -f "$DEMO_IMAGE_DB" ]]; then
    python3 "$ROOT/installer/linux-demo/tools/verify_demo_database.py" \
        "$DEMO_MAIN_DB" "$DEMO_IMAGE_DB"
else
    python3 "$ROOT/installer/linux-demo/tools/verify_demo_database.py" \
        "$DEMO_MAIN_DB"
    if [[ -f "$ROOT/demo/usg_image_demo.sqlite3" ]]; then
        warn "demo/usg_image_demo.sqlite3 nu este inclus automat. Pentru includere, "
        warn "pregătiți o copie anonimizată și compatibilă numită usg_demo_images.sqlite3."
    fi
fi

if [[ "$VERIFY_ONLY" == "1" ]]; then
    log "Verificarea bazelor demo s-a încheiat; construirea a fost omisă (VERIFY_ONLY=1)."
    exit 0
fi

require_cmd "$CQTDEPLOYER" "$BINARYCREATOR" "$QMAKE" rsync readelf ldd sha256sum strings

rm -rf -- "$WORK_ROOT"
mkdir -p "$PREBUILD_DIR" "$RUNTIME_DIR" "$INSTALLER_DIR/config" \
         "$INSTALLER_DIR/packages/com.alovada.usg.demo/meta"

log "Copiem build-ul Release și resursele necesare..."
rsync -a --delete "$ROOT/$RELEASE_DIR/" "$PREBUILD_DIR/"
rsync -a "$ROOT/resources/icons" "$PREBUILD_DIR/"
rsync -a "$ROOT/resources/templets" "$PREBUILD_DIR/"
install -m 0644 "$ROOT/version.txt" "$PREBUILD_DIR/version.txt"
find "$PREBUILD_DIR" -type f -name 'moc_*' -delete

log "Construim runtime-ul demo cu cqtdeployer..."
"$CQTDEPLOYER" clear \
    -bin "$PREBUILD_DIR/USG" \
    -qmake "$QMAKE" \
    -libDir "$QT_LIB_DIR" \
    -extraData "$ROOT/resources/templets,$ROOT/resources/icons" \
    -targetDir "$RUNTIME_DIR"

mkdir -p "$RUNTIME_DIR/lib" "$RUNTIME_DIR/plugins/printsupport" \
         "$RUNTIME_DIR/licenses/LimeReport" \
         "$RUNTIME_DIR/licenses/QSQLCipher/source" "$RUNTIME_DIR/demo" \
         "$RUNTIME_DIR/demo-tools" "$RUNTIME_DIR/logs" \
         "$RUNTIME_DIR/reports" "$RUNTIME_DIR/video"

copy_checked() {
    local source_file="$1"
    local destination_file="$2"
    [[ -f "$source_file" ]] || die "Lipsește fișierul: $source_file"
    install -m 0644 "$source_file" "$destination_file"
}

copy_checked "$ROOT/3rdparty/openssl/libcrypto.so.3" "$RUNTIME_DIR/lib/libcrypto.so.3"
copy_checked "$ROOT/3rdparty/openssl/libssl.so.3" "$RUNTIME_DIR/lib/libssl.so.3"

openssl_runtime_version="$(
    strings "$RUNTIME_DIR/lib/libcrypto.so.3" \
        | grep '^OpenSSL [0-9]' \
        | sed -n '1p'
)"
[[ "$openssl_runtime_version" == "OpenSSL 3.5.9 "* ]] \
    || die "Versiune OpenSSL neașteptată în pachetul demo: $openssl_runtime_version"

for library in \
    liblimereport.so liblimereport.so.1 liblimereport.so.1.0 \
    liblimereport.so.1.0.0 libQtZint.so; do
    copy_checked "$ROOT/3rdparty/LimeReport/release/$library" "$RUNTIME_DIR/lib/$library"
done

for library in \
    "libQt6Designer.so.6" "libQt6Designer.so.${QT_VERSION}" \
    "libQt6DesignerComponents.so.6" "libQt6DesignerComponents.so.${QT_VERSION}" \
    "libQt6OpenGLWidgets.so.6" "libQt6OpenGLWidgets.so.${QT_VERSION}" \
    "libQt6PrintSupport.so.6" "libQt6PrintSupport.so.${QT_VERSION}" \
    "libQt6UiTools.so.6" "libQt6UiTools.so.${QT_VERSION}"; do
    copy_checked "$QT_LIB_DIR/$library" "$RUNTIME_DIR/lib/$library"
done

copy_checked "$QT_PLUGINS_DIR/printsupport/libcupsprintersupport.so" \
             "$RUNTIME_DIR/plugins/printsupport/libcupsprintersupport.so"

if [[ -f "$QT_PLUGINS_DIR/sqldrivers/libqsqlcipher.so" ]]; then
    mkdir -p "$RUNTIME_DIR/plugins/sqldrivers"
    copy_checked "$QT_PLUGINS_DIR/sqldrivers/libqsqlcipher.so" \
                 "$RUNTIME_DIR/plugins/sqldrivers/libqsqlcipher.so"

    qsqlcipher_ldd="$(
        LD_LIBRARY_PATH="$RUNTIME_DIR/lib" \
            ldd "$RUNTIME_DIR/plugins/sqldrivers/libqsqlcipher.so"
    )"
    if grep -Fq 'not found' <<< "$qsqlcipher_ldd"; then
        printf '%s\n' "$qsqlcipher_ldd" >&2
        die "Pluginul QSQLCIPHER demo conține dependențe runtime nerezolvate."
    fi
    grep -F "$RUNTIME_DIR/lib/libcrypto.so.3" <<< "$qsqlcipher_ldd" >/dev/null \
        || die "Pluginul QSQLCIPHER demo nu folosește copia OpenSSL privată."
fi

[[ -x "$RUNTIME_DIR/bin/USG" ]] || die "Executabilul distribuit lipsește."
dynamic_section="$(readelf -d "$RUNTIME_DIR/bin/USG")"
[[ "$dynamic_section" == *'$ORIGIN/../lib'* ]] \
    || die 'Executabilul nu conține RPATH-ul portabil $ORIGIN/../lib.'

ldd_output="$(env -u LD_LIBRARY_PATH ldd "$RUNTIME_DIR/bin/USG")"
if grep -Fq 'not found' <<< "$ldd_output"; then
    printf '%s\n' "$ldd_output" >&2
    die "Pachetul demo conține dependențe runtime nerezolvate."
fi

log "Adăugăm bazele și configurarea automată demo..."
install -m 0644 "$DEMO_MAIN_DB" "$RUNTIME_DIR/demo/usg_demo.sqlite3"

if [[ -f "$DEMO_IMAGE_DB" ]]; then
    install -m 0644 "$DEMO_IMAGE_DB" "$RUNTIME_DIR/demo/usg_demo_images.sqlite3"
    image_rows="$(sqlite3 "$DEMO_IMAGE_DB" 'SELECT COUNT(*) FROM imagesReports;')"
    log "Baza de imagini demo a fost inclusă: $image_rows înregistrări."
else
    warn "Nu există $DEMO_IMAGE_DB; generăm o bază de imagini goală."
    sqlite3 "$RUNTIME_DIR/demo/usg_demo_images.sqlite3" \
        < "$ROOT/resources/sql/sqlite/tables/image_reports.sql"
    chmod 0644 "$RUNTIME_DIR/demo/usg_demo_images.sqlite3"
fi

# Sincronizăm marcajele exclusiv în copia livrată. Astfel, o bază de imagini
# goală nu lasă în jurnale pictograme pentru atașamente inexistente, iar
# fișierele sursă din demo/ rămân nemodificate.
sqlite3 "$RUNTIME_DIR/demo/usg_demo.sqlite3" <<SQL
ATTACH DATABASE '$RUNTIME_DIR/demo/usg_demo_images.sqlite3' AS demo_images;
UPDATE orderEcho
SET attachedImages = CASE
    WHEN EXISTS (
        SELECT 1 FROM demo_images.imagesReports AS image
        WHERE image.id_orderEcho = orderEcho.id
    ) THEN 1 ELSE 0 END;
UPDATE reportEcho
SET attachedImages = CASE
    WHEN EXISTS (
        SELECT 1 FROM demo_images.imagesReports AS image
        WHERE image.id_reportEcho = reportEcho.id
    ) THEN 1 ELSE 0 END;
DETACH DATABASE demo_images;
SQL

packaged_integrity="$(sqlite3 "$RUNTIME_DIR/demo/usg_demo.sqlite3" 'PRAGMA integrity_check;')"
[[ "$packaged_integrity" == "ok" ]] \
    || die "Copia bazei principale din pachet nu trece verificarea finală."

install -m 0755 "$ROOT/installer/linux-demo/runtime/configure-demo-profile.sh" \
                "$RUNTIME_DIR/demo-tools/configure-demo-profile.sh"
install -m 0755 "$ROOT/installer/linux-demo/runtime/USG-Demo.sh" \
                "$RUNTIME_DIR/USG-Demo.sh"
install -m 0644 "$ROOT/installer/linux-demo/runtime/README-DEMO.md" \
                "$RUNTIME_DIR/README-DEMO.md"

copy_checked "$ROOT/LICENSE.txt" "$RUNTIME_DIR/licenses/LICENSE.txt"
copy_checked "$ROOT/third_party/THIRD_PARTY_ICONS.md" \
             "$RUNTIME_DIR/licenses/THIRD_PARTY_ICONS.md"
copy_checked "$ROOT/third_party/LIMEREPORT.md" \
             "$RUNTIME_DIR/licenses/LimeReport/README.md"
copy_checked "$ROOT/third_party/QSQLCIPHER.md" \
             "$RUNTIME_DIR/licenses/QSQLCipher/README.md"
copy_checked "$ROOT/third_party/licenses/OpenSSL-Apache-2.0.txt" \
             "$RUNTIME_DIR/licenses/QSQLCipher/OpenSSL-Apache-2.0.txt"
copy_checked "$ROOT/third_party/licenses/SQLCipher-BSD-3-Clause.txt" \
             "$RUNTIME_DIR/licenses/QSQLCipher/SQLCipher-BSD-3-Clause.txt"
install -m 0755 "$ROOT/build_scripts/build_openssl" \
                "$RUNTIME_DIR/licenses/QSQLCipher/build_openssl"
rsync -a \
    --exclude='_deps/' \
    --exclude='build/' \
    "$ROOT/third_party/qsqlcipher/source/" \
    "$RUNTIME_DIR/licenses/QSQLCipher/source/"

chmod -R go-w "$RUNTIME_DIR"

log "Pregătim instalatorul Qt IFW demo..."
rsync -a --exclude='config.xml' "$ROOT/installer/linux/config/" "$INSTALLER_DIR/config/"
install -m 0644 "$ROOT/installer/linux-demo/config/config.xml" \
                "$INSTALLER_DIR/config/config.xml"
rsync -a "$ROOT/installer/linux-demo/packages/com.alovada.usg.demo/meta/" \
          "$INSTALLER_DIR/packages/com.alovada.usg.demo/meta/"
install -m 0644 "$ROOT/LICENSE.txt" \
                "$INSTALLER_DIR/packages/com.alovada.usg.demo/meta/license.txt"
rsync -a "$RUNTIME_DIR/" "$INSTALLER_DIR/packages/com.alovada.usg.demo/data/"

release_date="$(date +%Y-%m-%d)"
sed -i \
    -e "s/@@VERSION@@/$VERSION/g" \
    "$INSTALLER_DIR/config/config.xml"
sed -i \
    -e "s/@@VERSION@@/$VERSION/g" \
    -e "s/@@RELEASE_DATE@@/$release_date/g" \
    "$INSTALLER_DIR/packages/com.alovada.usg.demo/meta/package.xml"

log "Generăm $FILENAME_RUN..."
rm -f -- "$ROOT/build/$FILENAME_RUN" "$ROOT/build/$FILENAME_SHA256"
"$BINARYCREATOR" \
    -c "$INSTALLER_DIR/config/config.xml" \
    -p "$INSTALLER_DIR/packages" \
    "$ROOT/build/$FILENAME_RUN"

sha256sum "$ROOT/build/$FILENAME_RUN" | awk '{print $1}' \
    > "$ROOT/build/$FILENAME_SHA256"

log "Pachetul demo a fost creat cu succes:"
printf '  %s\n  %s\n' \
    "$ROOT/build/$FILENAME_RUN" \
    "$ROOT/build/$FILENAME_SHA256"
